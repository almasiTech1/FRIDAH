# Production environment template for the Fridah backend.
#
# Copy this to `.env` on the server (NEVER commit the real .env) and fill in every
# value marked CHANGE-ME. `docker-compose.yml` loads this automatically via `env_file: .env`.
#
#   cp .env.production.example .env
#   nano .env   # fill in the real values
#
# Generate a real SECRET_KEY with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# ---------------------------------------------------------------------------
# Core Django
# ---------------------------------------------------------------------------
SECRET_KEY=CHANGE-ME-generate-a-real-random-secret-key
DEBUG=False
ALLOWED_HOSTS=api.fridah.co.ke
USE_SQLITE=False

# ---------------------------------------------------------------------------
# Database (docker-compose.yml's `db` service already sets DB_HOST=db internally -
# these are the credentials that service is created with, so keep them in sync)
# ---------------------------------------------------------------------------
DB_NAME=fridah
DB_USER=fridah
DB_PASSWORD=CHANGE-ME-use-a-long-random-password

# ---------------------------------------------------------------------------
# CORS / CSRF - must list every origin your deployed frontend(s) actually use
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://fridah.co.ke,https://www.fridah.co.ke
CSRF_TRUSTED_ORIGINS=https://api.fridah.co.ke,https://fridah.co.ke

# ---------------------------------------------------------------------------
# M-Pesa (Safaricom Daraja API) - leave blank to disable M-Pesa features gracefully
# ---------------------------------------------------------------------------
MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
# Must be this server's public HTTPS URL - Safaricom calls back to several endpoints
# under <MPESA_CALLBACK_BASE_URL>/api/v1/payments/mpesa/ (stk-callback/, c2b-confirmation/,
# b2c-result/, etc. - see apps/payments/urls.py for the full list)
MPESA_CALLBACK_BASE_URL=https://api.fridah.co.ke

# ---------------------------------------------------------------------------
# Africa's Talking (SMS / USSD) - leave blank to disable gracefully
# ---------------------------------------------------------------------------
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=FRIDAH
USSD_SHARED_SECRET=CHANGE-ME-random-string-appended-to-your-AT-USSD-callback-URL
USSD_SERVICE_CODE=*483*XXX#

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta) - leave blank to disable gracefully
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=CHANGE-ME-random-string-you-also-enter-in-the-Meta-dashboard
WHATSAPP_APP_SECRET=

# ---------------------------------------------------------------------------
# Anthropic (AI features) - leave blank to disable gracefully; app runs fine without it
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Email (SendGrid by default - swap EMAIL_HOST/PORT for another provider if needed)
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=CHANGE-ME-your-sendgrid-api-key
DEFAULT_FROM_EMAIL=no-reply@fridah.co.ke

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# The deployed web app's URL - used in outgoing emails/SMS as a link back into the app
FRONTEND_URL=https://fridah.co.ke
SECURE_SSL_REDIRECT=True


# Reverse proxies in front of the API: 1 = nginx only, 2 = Cloudflare in front of nginx, 0 = none.
# ONE setting for both the API rate limits and the M-Pesa callback IP check, so they cannot disagree about who the
# real client is. Set it wrong and rate limits (including the login limit) can be dodged with a fake X-Forwarded-For.
TRUSTED_PROXY_COUNT=1
# Django admin site: move it off the obvious /admin/ address and (optionally) limit it to your office / VPN.
# ADMIN_URL=ops-change-this-to-something-random/
# ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.0/24

# Rate limits (defaults shown). Visitors on shared mobile-network IPs share the anon limit,
# so consider raising THROTTLE_ANON once you have real traffic numbers.
# THROTTLE_ANON=600/hour
# THROTTLE_USER=1000/hour
# THROTTLE_LOGIN=10/min
