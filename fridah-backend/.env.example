# ===========================================================================
# FRIDAH Backend — Environment Configuration Template
# Copy to .env and fill in real values. Never commit .env to version control.
# ===========================================================================

# --- Django core ---
# Required when DEBUG=False: the app refuses to start with a placeholder or short key.
# Generate one: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.fridah.co.ke
FRONTEND_URL=https://fridah.co.ke

# --- Database (PostgreSQL) ---
DB_NAME=fridah
DB_USER=fridah
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://fridah.co.ke,https://www.fridah.co.ke
CSRF_TRUSTED_ORIGINS=https://api.fridah.co.ke,https://fridah.co.ke

# --- M-Pesa Daraja 2.0 ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_CALLBACK_BASE_URL=https://api.fridah.co.ke

# --- Africa's Talking SMS ---
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=FRIDAH

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
# Meta App Secret - used to verify the X-Hub-Signature-256 header on every incoming
# webhook POST. Required in production: without it, incoming WhatsApp messages are
# accepted with NO proof they actually came from Meta (spoofable). Find it under
# Meta App Dashboard > Settings > Basic > App Secret.
WHATSAPP_APP_SECRET=

# --- USSD (Africa's Talking) ---
USSD_SERVICE_CODE=*483*XXX#
# Africa's Talking doesn't sign USSD callbacks, so this shared secret is appended
# as ?secret=... to the callback URL you register with AT, and checked on every
# request. Required in production: without it, anyone who finds the callback URL
# can submit requests as any tenant's phone number.
USSD_SHARED_SECRET=

# --- Anthropic (AI features: property assistant, rent estimator, listing generator, maintenance triage) ---
# Get a key at https://console.anthropic.com/. Without it, AI endpoints return 503 gracefully.
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_QUALITY=claude-sonnet-5

# --- Email (SendGrid SMTP) ---
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@fridah.co.ke

# --- Business rules ---
OTP_EXPIRY_MINUTES=10
PLATFORM_COMMISSION_PERCENT=5.0
LATE_PAYMENT_GRACE_DAYS=5
LATE_PAYMENT_PENALTY_PERCENT=2.0

# --- Security ---
SECURE_SSL_REDIRECT=True

# --- Local development only ---
# Uses a local sqlite3 file instead of PostgreSQL, so you can run the backend
# without Docker/Postgres for quick local dev or CI. Leave unset (or False) for
# anything resembling production - Postgres is the only supported prod database.
USE_SQLITE=False

# Advanced/rarely-changed - safe to leave at the default:
# CRON_MONTHLY_INVOICES=86400   # seconds between checks for monthly invoice generation (idempotent)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend  # use ...console.EmailBackend to print emails to stdout in dev

# --- Refund policy (KES) ---
# Up to this amount a refund can be approved by the payment's recipient (landlord/host) or an administrator;
# above it, and for every reversal, only an administrator can approve.
REFUND_ADMIN_APPROVAL_ABOVE=5000
# Refunds can only be requested for payments completed within this many days.
REFUND_WINDOW_DAYS=180
# Keep False: the person who requested a refund can never approve it (maker-checker).
REFUND_ALLOW_SELF_APPROVAL=False
# Number of reverse proxies in front of the app (see docs notes, payments hardening).
TRUSTED_PROXY_COUNT=1

# Send approved refunds to customers automatically via M-Pesa B2C. Needs MPESA_INITIATOR_* and the Safaricom certificate in config/certs/.
MPESA_B2C_REFUNDS_ENABLED=False
